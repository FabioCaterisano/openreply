# --- App ---
NEXTAUTH_URL=https://reply.catno.ai
NEXTAUTH_SECRET=            # openssl rand -hex 32
CRON_SECRET=                # openssl rand -hex 32
ENCRYPTION_KEY=             # openssl rand -hex 32  (exakt 64 Hex, identisch in web/worker)
ALLOWED_EMAILS=fc@fcaterisano.de,dev@catno.ai

# --- Data ---
POSTGRES_PASSWORD=          # openssl rand -hex 24
DATABASE_URL=postgresql://openreply:${POSTGRES_PASSWORD}@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# --- Login-Mails (Magic Link) über Gmail-SMTP statt Resend ---
EMAIL_SERVER=smtps://hello%40catno.ai:APP_PASSWORD@smtp.gmail.com:465
EMAIL_FROM=CATNO Reply <hello@catno.ai>

# --- Meta / Instagram (docs/setup.md, Schritte 4-9) ---
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=       # openssl rand -hex 16

# --- CATNO-Erweiterungen ---
DROPS_JSON_URL=https://decks.catno.ai/freestuff/drops.json
DROPS_CACHE_SECONDS=300
FREE_LIBRARY_URL=https://catno.ai/free
OUTBOUND_WEBHOOK_URL=       # n8n Webhook, leer = aus
OUTBOUND_WEBHOOK_SECRET=    # openssl rand -hex 32
